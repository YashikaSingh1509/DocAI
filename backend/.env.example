# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docai?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Webhook (optional - leave empty for dev mode mock)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node environment
NODE_ENV=development

# Server port
PORT=3000
